# ==============================================================================
# Umrah Operations System - Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# Public API Gateway Port
PORT=5000

# MySQL Database Configuration
MYSQL_CONTAINER_NAME=umrah-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=umrah_db
MYSQL_USER=umrah_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# Database connection credentials used by microservices
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=umrah_db

# phpMyAdmin Configuration
PMA_CONTAINER_NAME=umrah-phpmyadmin
PMA_PORT=8080
PMA_UPLOAD_LIMIT=64M

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Super Admin Default Password
ADMIN_DEFAULT_PASSWORD=your_initial_admin_password_here

# Titan Email / SMTP Configuration
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM_NAME="ODST Umrah Operations System"
SMTP_FROM_EMAIL=your_email@domain.com
